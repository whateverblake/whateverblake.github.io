;pre style=&quot;background-color: rgb(255 , 255 , 255) ; font-family: &amp;#34;menlo&amp;#34; ; font-size: 10.5pt&quot;&gt;&lt;pre style=&quot;font-family: &amp;#34;menlo&amp;#34; ; font-size: 10.5pt&quot;&gt;Record&lt;/pre&gt;&lt;/pre&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1"><mxGeometry x="1221.25" y="1610" width="42.5" height="20" as="geometry" /></mxCell><mxCell id="GwyQWO2RPQr_w0LrGCnW-79" value="&lt;pre style=&quot;background-color: rgb(255 , 255 , 255) ; font-family: &amp;#34;menlo&amp;#34; ; font-size: 10.5pt&quot;&gt;&lt;pre style=&quot;font-family: &amp;#34;menlo&amp;#34; ; font-size: 10.5pt&quot;&gt;&lt;span style=&quot;color: rgb(25 , 72 , 166) ; font-weight: bold&quot;&gt;version int&lt;/span&gt;&lt;/pre&gt;&lt;pre style=&quot;font-family: &amp;#34;menlo&amp;#34; ; font-size: 10.5pt&quot;&gt;&lt;pre style=&quot;font-family: &amp;#34;menlo&amp;#34; ; font-size: 10.5pt&quot;&gt;&lt;span style=&quot;color: rgb(25 , 72 , 166) ; font-weight: bold&quot;&gt;treeDigest long&lt;/span&gt;&lt;/pre&gt;&lt;/pre&gt;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1159" y="1760" width="160" height="90" as="geometry" /></mxCell><mxCell id="GwyQWO2RPQr_w0LrGCnW-80" value="&lt;pre style=&quot;background-color: rgb(255 , 255 , 255) ; font-family: &amp;#34;menlo&amp;#34; ; font-size: 10.5pt&quot;&gt;TxnDigest&lt;/pre&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1"><mxGeometry x="1218" y="1760" width="40" height="20" as="geometry" /></mxCell><mxCell id="GwyQWO2RPQr_w0LrGCnW-82" value="&lt;pre style=&quot;background-color: rgb(255 , 255 , 255) ; font-family: &amp;#34;menlo&amp;#34; ; font-size: 10.5pt&quot;&gt;TxnLogEntry&lt;/pre&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1"><mxGeometry x="1218" y="1350" width="40" height="20" as="geometry" /></mxCell><mxCell id="GwyQWO2RPQr_w0LrGCnW-84" value="Compare each parsed &lt;span style=&quot;background-color: rgb(255 , 255 , 255) ; font-family: &amp;#34;menlo&amp;#34; ; font-size: 10.5pt&quot;&gt;TxnLogEntry's zxid with log_zxid; while zxid &amp;lt; &lt;/span&gt;&lt;span style=&quot;font-family: &amp;#34;menlo&amp;#34; ; font-size: 14px ; background-color: rgb(255 , 255 , 255)&quot;&gt;log_zxid, skip it.&lt;/span&gt;&lt;span style=&quot;font-family: &amp;#34;menlo&amp;#34; ; font-size: 14px ; background-color: rgb(255 , 255 , 255)&quot;&gt;&lt;br&gt;Then, based on the &lt;/span&gt;&lt;span style=&quot;font-family: &amp;#34;menlo&amp;#34; ; font-size: 14px ; background-color: rgb(255 , 255 , 255)&quot;&gt;TxnLogEntry type, run&lt;br&gt;&lt;/span&gt;&lt;pre style=&quot;background-color: rgb(255 , 255 , 255) ; font-family: &amp;#34;menlo&amp;#34; ; font-size: 10.5pt&quot;&gt;processTransaction&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1140" y="2060" width="310" height="140" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>